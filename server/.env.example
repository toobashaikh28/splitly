PORT=5000
MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=replace_with_a_long_random_string

# Optional — only needed for the AI bill-scan feature.
# Without this, /api/ai/scan-receipt returns a clear "not configured" error
# and the app falls back to manual entry, which works fully without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
